# Include in nginx's http {} context. Replace domains and TLS paths.
limit_req_zone $binary_remote_addr zone=mate_api:10m rate=5r/s;

server {
    listen 80;
    listen [::]:80;
    server_name ranking.example.com;
    return 308 https://ranking.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ranking.example.com;
    ssl_certificate /etc/letsencrypt/live/ranking.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ranking.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4k;
    client_body_timeout 10s;
    client_header_timeout 10s;

    location / {
        limit_req zone=mate_api burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Always overwrite these; never preserve client-supplied forwarding values.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}
